<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="게임 난이도">

        <ListPreference
            app:key="memorize_time"
            app:title="암기 시간"
            app:summary="숫자를 외울 시간을 선택합니다."
            app:entries="@array/time_entries"
            app:entryValues="@array/time_values"
            app:defaultValue="3" />

    </PreferenceCategory>

    <PreferenceCategory app:title="디자인">

        <ListPreference
            app:key="background_theme"
            app:title="배경 테마"
            app:summary="게임 배경화면을 변경합니다."
            app:entries="@array/theme_entries"
            app:entryValues="@array/theme_values"
            app:defaultValue="default" />

    </PreferenceCategory>

</PreferenceScreen>
